  "manual_edges": [
    {"from": "entry.flowspace", "to": "surface.onboarding.welcome", "kind": "renders"},
    {"from": "entry.flowspace", "to": "surface.system_graph", "kind": "renders"},
    {"from": "surface.onboarding.welcome", "to": "surface.onboarding.login", "kind": "navigates"},
    {"from": "surface.onboarding.welcome", "to": "surface.onboarding.setup", "kind": "navigates"},
    {"from": "surface.onboarding.login", "to": "file:client_flutter/lib/services/auth_service.dart", "kind": "invokes"},
    {"from": "surface.onboarding.setup", "to": "file:client_flutter/lib/services/auth_service.dart", "kind": "invokes"},
    {"from": "surface.onboarding.setup", "to": "surface.onboarding.setup_complete", "kind": "navigates"},
    {"from": "surface.onboarding.setup_complete", "to": "surface.system_graph", "kind": "navigates"},
    {"from": "file:client_flutter/lib/services/auth_service.dart", "to": "persistence.sqlite", "kind": "reads_writes"},
    {"from": "surface.system_graph", "to": "interaction.system_graph.search", "kind": "contains"},
    {"from": "surface.system_graph", "to": "interaction.system_graph.scope", "kind": "contains"},
    {"from": "interaction.system_graph.search", "to": "state.system_graph.document", "kind": "filters"},
    {"from": "interaction.system_graph.scope", "to": "state.system_graph.document", "kind": "filters"},
    {"from": "surface.system_graph", "to": "service.system_graph.asset_repository", "kind": "invokes"},
    {"from": "service.system_graph.asset_repository", "to": "artifact.system_graph.json", "kind": "reads"},
    {"from": "artifact.system_graph.json", "to": "state.system_graph.document", "kind": "hydrates"},
    {"from": "gate.system_graph", "to": "artifact.system_graph.json", "kind": "regenerates_checks"},
    {"from": "test.system_graph", "to": "surface.system_graph", "kind": "proves"},
    {"from": "test.shipping_surface_contract", "to": "entry.flowspace", "kind": "proves"},
    {"from": "test.shipping_surface_contract", "to": "surface.onboarding.welcome", "kind": "proves"},
    {"from": "test.shipping_surface_contract", "to": "surface.onboarding.login", "kind": "proves"},
    {"from": "test.shipping_surface_contract", "to": "surface.onboarding.setup", "kind": "proves"},
    {"from": "test.shipping_surface_contract", "to": "surface.onboarding.setup_complete", "kind": "proves"},
    {"from": "backend.api", "to": "persistence.sqlite", "kind": "does_not_own"}
  ]
