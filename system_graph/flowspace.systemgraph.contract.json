      "source": "client_flutter/lib/ui/screens/workspace_screen.dart",
      "reason": "Hard-coded user, workspace, activity, project, progress, and release data plus empty navigation actions."
    },
    {
      "id": "surface.streams",
      "label": "Streams",
      "source": "client_flutter/lib/ui/screens/streams_screen.dart",
      "reason": "Core read/send paths have local fallback, but visible reactions, threads, pins, and header actions are not locally wired."
    },
    {
      "id": "surface.connect",
      "label": "Connect",
      "source": "client_flutter/lib/ui/views/meet_view.dart",
      "reason": "Visible meeting actions require backend endpoints and have no truthful local-mode capability path."
    },
    {
      "id": "surface.calendar",
      "label": "Calendar",
      "source": "client_flutter/lib/ui/views/calendar_view.dart",
      "reason": "The visible surface is a date picker without event state, persistence, scheduling, or calendar tests."
    },
    {
      "id": "surface.vault",
      "label": "Vault",
      "source": "client_flutter/lib/ui/screens/vault_screen.dart",
      "reason": "Listing can fall back to SQLite, but visible upload, delete, and open paths are not a complete local-first contract."
    },
    {
      "id": "surface.projects",
      "label": "Projects",
      "source": "client_flutter/lib/ui/screens/projects_screen.dart",
      "reason": "Local project/task code exists, but the complete visible journey lacks an isolated integration proof and graph-bound control inventory."
    },
    {
      "id": "surface.settings",
      "label": "Settings",
      "source": "client_flutter/lib/ui/screens/settings_screen.dart",
      "reason": "The visible settings tree contains null handlers and explicit coming-soon actions."
    }
