{
    "name": "backend",
    "version": "1.2.0-20251130.0000",
    "description": "",
    "main": "index.js",
    "bin": "dist/src/main.js",
    "scripts": {
        "prestart:dev": "node -e \"require('child_process').exec('npx prisma generate', (err) => { if (err) console.log('Prisma generate skipped (files locked, will retry on startup)'); process.exit(0); });\"",
        "start:dev": "nodemon --exec ts-node src/main.ts",
        "test": "npm run build",
        "build": "npx prisma generate && nest build",
        "prestart:prod": "npm run build",
        "start": "ts-node -r tsconfig-paths/register src/main.ts",
        "start:prod": "node dist/src/main.js",
        "stop": "pwsh -File stop-backend.ps1",
        "stop-port": "pwsh -File stop-port-4000.ps1"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "prisma": {
        "seed": "ts-node ./prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.940.0",
        "@nestjs/cli": "^11.0.4",
        "@nestjs/common": "^11.1.8",
