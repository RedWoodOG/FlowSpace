        "@nestjs/core": "^11.1.8",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/platform-express": "^11.1.8",
        "@nestjs/platform-socket.io": "^11.1.8",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.0",
        "@nestjs/websockets": "^11.1.8",
        "@prisma/client": "^6.19.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^4.17.21",
