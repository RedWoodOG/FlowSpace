        "@types/multer": "^2.0.0",
        "@types/node": "^24.10.0",
        "@types/nodemailer": "^7.0.4",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "helmet": "^8.1.0",
